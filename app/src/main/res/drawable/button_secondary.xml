<?xml version="1.0" encoding="utf-8"?>
<ripple
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#200F766E">
    <item>
        <selector>
            <item
                android:state_enabled="false">
                <shape>
                    <solid
                        android:color="@color/surface_soft" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/border" />
                    <corners
                        android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid
                        android:color="@color/surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/brand" />
                    <corners
                        android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
