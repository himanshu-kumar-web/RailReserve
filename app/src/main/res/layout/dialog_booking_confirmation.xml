<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/confirmationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_confirmed"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/brand_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="DEMO PNR"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/confirmationPnr"
                android:textIsSelectable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/navy"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_weight="1" />
            <ImageButton
                android:id="@+id/copyPnrButton"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:background="@drawable/button_secondary"
                app:backgroundTint="@null"
                android:contentDescription="@string/copy_demo_pnr"
                android:padding="12dp"
                android:src="@drawable/ic_copy"
                android:scaleType="centerInside" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="RailReserve identifier. Not an Indian Railways PNR."
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="@color/border" />
        <TextView
            android:id="@+id/confirmationTrain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/confirmationRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/confirmationJourney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/confirmationPassenger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:textColor="@color/ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/confirmationSeatClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/confirmationFare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="@color/teal_soft"
            android:padding="11dp"
            android:textColor="@color/brand_dark"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/confirmationPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textIsSelectable="true"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/brand_dark"
            android:textSize="13sp" />
        <Button
            android:id="@+id/downloadTicketPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:minHeight="52dp"
            android:text="@string/download_ticket_pdf"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
