<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/bookingPnr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
        <ImageButton
            android:id="@+id/copyPnrButton"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:background="@drawable/button_secondary"
            app:backgroundTint="@null"
            android:contentDescription="@string/copy_demo_pnr"
            android:padding="12dp"
            android:src="@drawable/ic_copy"
            android:scaleType="centerInside" />
    </LinearLayout>
    <TextView
        android:id="@+id/bookingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/status_confirmed"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:accessibilityLiveRegion="polite"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/bookingTrain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textAppearance="@style/TextAppearance.RailReserve.Section" />
    <TextView
        android:id="@+id/bookingRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/bookingTimes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/border" />
    <TextView
        android:id="@+id/bookingPassenger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/bookingClassFare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/brand_dark"
        android:textSize="14sp"
        android:textStyle="bold" />
    <Button
        android:id="@+id/bookingReceiptToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/button_secondary"
        app:backgroundTint="@null"
        android:text="@string/show_receipt"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="@color/brand_dark"
        android:padding="10dp" />
    <TextView
        android:id="@+id/bookingPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:visibility="gone"
        android:textIsSelectable="true" />
    <Button
        android:id="@+id/cancelBookingButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_cancel"
        android:minHeight="48dp"
        android:text="Cancel booking"
        android:textAllCaps="false"
        android:textColor="#9A3328"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        android:backgroundTint="@null"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />
</LinearLayout>
