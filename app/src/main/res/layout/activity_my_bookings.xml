<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_soft"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hero_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAILRESERVE  /  TRAVEL RECORDS"
            android:textColor="#C3D9E6"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="My bookings"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="View your tickets and manage active reservations."
            android:textColor="#D9E3F0"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/bookingsProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bookingsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/card_background"
        android:gravity="center"
        android:minHeight="130dp"
        android:padding="22dp"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/emptySearchButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_primary"
        android:minHeight="48dp"
        android:text="Search trains"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:visibility="gone" />

    <ListView
        android:id="@+id/bookingsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:paddingBottom="12dp" />
</LinearLayout>
