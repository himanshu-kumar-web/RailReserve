<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_soft"
    android:clipToPadding="false"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include layout="@layout/view_screen_back" />
        <TextView
            android:id="@+id/bookingSimulationNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/teal_soft"
            android:padding="12dp"
            android:text="@string/checkout_demo_notice"
            android:textColor="@color/brand_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/bookingSimulationPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/simulation_policy"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/bookingForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEMO BOOKING - PASSENGER DETAILS"
                android:textColor="@color/brand_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Passenger details"
                android:textColor="@color/navy"
                android:textSize="26sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_background"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JOURNEY SUMMARY"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
                <TextView
                    android:id="@+id/bookingTrainSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="3dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/border" />
                <TextView
                    android:id="@+id/bookingSelectedSeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Select an available seat below"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/bookingFareSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/brand_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="AVAILABLE SEAT"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/seatSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/booking_input_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:popupBackground="@color/surface"
                android:minHeight="54dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ProgressBar
                    android:id="@+id/seatProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/seatStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PASSENGER DETAILS"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Full name"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:labelFor="@id/passengerNameInput" />
            <EditText
                android:id="@+id/passengerNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/booking_input_background"
                android:hint="Passenger full name"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="80"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp"
                android:minHeight="54dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/passengerAgeInput" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Age"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:labelFor="@id/passengerAgeInput" />
            <EditText
                android:id="@+id/passengerAgeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/booking_input_background"
                android:hint="Age in years"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp"
                android:minHeight="54dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:imeOptions="actionDone" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gender"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:labelFor="@id/genderSpinner" />
            <Spinner
                android:id="@+id/genderSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/booking_input_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:popupBackground="@color/surface"
                android:minHeight="54dp" />
            <TextView
                android:id="@+id/genderError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:text="Select a gender."
                android:textColor="#B3261E"
                android:textSize="12sp"
                android:visibility="gone" />
            <Button
                android:id="@+id/confirmBookingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/button_primary"
                android:minHeight="56dp"
                android:text="Review demo booking"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:backgroundTint="@null"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="Local demo reservation only. Demo UPI is simulated; no real payment or railway ticket is issued."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
        <include
            layout="@layout/view_demo_checkout" />
    </LinearLayout>
</ScrollView>
