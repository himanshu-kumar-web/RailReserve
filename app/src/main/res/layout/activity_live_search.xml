<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/liveSearchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_soft"
    android:orientation="vertical">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/live_hero_background"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="0dp"
                    android:text="RailReserve"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/live_home_title"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_supporting_text"
                    android:textColor="#DDE9EE"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/live_search_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/station_source_label"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:labelFor="@id/liveSourceInput" />
                <AutoCompleteTextView
                    android:id="@+id/liveSourceInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/input_background"
                    android:completionThreshold="2"
                    android:hint="@string/station_search_hint"
                    android:inputType="textCapWords"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp"
                    android:minHeight="58dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@id/liveDestinationInput" />
                <TextView
                    android:id="@+id/liveSourceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="20dp"
                    android:text="@string/station_search_minimum"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:accessibilityLiveRegion="polite" />
                <Button
                    android:id="@+id/liveSwapButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/button_secondary"
                    android:minWidth="0dp"
                    android:text="@string/swap_stations"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_dark"
                    android:textStyle="bold"
                    android:minHeight="48dp"
                    app:backgroundTint="@null"
                    android:backgroundTint="@null"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/station_destination_label"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:labelFor="@id/liveDestinationInput" />
                <AutoCompleteTextView
                    android:id="@+id/liveDestinationInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/input_background"
                    android:completionThreshold="2"
                    android:hint="@string/station_search_hint"
                    android:inputType="textCapWords"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp"
                    android:minHeight="58dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:imeOptions="actionDone" />
                <TextView
                    android:id="@+id/liveDestinationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="20dp"
                    android:text="@string/station_search_minimum"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:accessibilityLiveRegion="polite" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/journey_date_label"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/liveDateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_button_background"
                    android:gravity="center_vertical|start"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    android:backgroundTint="@null"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />
                <Button
                    android:id="@+id/liveSearchButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_primary"
                    android:minHeight="58dp"
                    android:text="@string/live_search_button"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    android:backgroundTint="@null"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/live_route_badge"
                android:padding="14dp"
                android:text="@string/live_mode_notice"
                android:textColor="@color/brand_dark"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    <include
        layout="@layout/view_bottom_navigation" />
</LinearLayout>
