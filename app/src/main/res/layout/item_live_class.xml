<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/live_search_card">
    <TextView android:id="@+id/classHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/classSource" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="13sp" />
    <ProgressBar android:id="@+id/classProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/classFare" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="@color/brand_dark" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/classFareCheck" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/check_provider_fare" android:textAllCaps="false"
        android:background="@drawable/button_secondary" android:textColor="@color/brand_dark" />
    <TextView android:id="@+id/classAvailability" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/classAvailabilityCheck" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/check_provider_availability" android:textAllCaps="false"
        android:background="@drawable/button_secondary" android:textColor="@color/brand_dark" />
    <TextView android:id="@+id/classDemoNotice" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="@color/muted" android:textSize="14sp" />
    <Button android:id="@+id/classDemoBook" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="52dp" android:layout_marginTop="8dp" android:text="@string/simulate_booking"
        android:textAllCaps="false" android:background="@drawable/button_primary" android:textColor="@color/white" android:textSize="16sp" />
</LinearLayout>
