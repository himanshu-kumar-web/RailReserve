<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_soft"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">
    <include layout="@layout/view_screen_back" />
    <com.railreserve.ui.BoundedHeaderScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/live_hero_background"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_brand"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="LIVE SCHEDULE"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/liveScheduleHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/liveScheduleSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#DDE9EE"
                    android:textSize="13sp" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/liveScheduleProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/liveScheduleStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/live_search_card"
                android:gravity="center"
                android:minHeight="110dp"
                android:padding="20dp"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite" />
            <Button
                android:id="@+id/liveScheduleRetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:minHeight="50dp"
                android:text="Retry schedule"
                android:textAllCaps="false"
                android:textColor="@color/brand_dark"
                android:visibility="gone"
                app:backgroundTint="@null"
                android:backgroundTint="@null"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </com.railreserve.ui.BoundedHeaderScrollView>
    <ListView
        android:id="@+id/liveScheduleList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:paddingBottom="12dp" />
</LinearLayout>
