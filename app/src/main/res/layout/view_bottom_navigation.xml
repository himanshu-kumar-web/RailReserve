<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:elevation="2dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">
    <Button
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:backgroundTint="@color/surface"
        android:minWidth="0dp"
        android:text="@string/nav_home"
        android:drawableTop="@drawable/ic_nav_home"
        android:drawablePadding="2dp"
        android:textAllCaps="false"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:minHeight="56dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/navigation_item"
        app:backgroundTint="@null"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />
    <Button
        android:id="@+id/navTickets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:backgroundTint="@color/surface"
        android:minWidth="0dp"
        android:text="@string/nav_tickets"
        android:drawableTop="@drawable/ic_nav_tickets"
        android:drawablePadding="2dp"
        android:textAllCaps="false"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:minHeight="56dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/navigation_item"
        app:backgroundTint="@null"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />
    <Button
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:backgroundTint="@color/surface"
        android:minWidth="0dp"
        android:text="@string/nav_profile"
        android:drawableTop="@drawable/ic_nav_profile"
        android:drawablePadding="2dp"
        android:textAllCaps="false"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:minHeight="56dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/navigation_item"
        app:backgroundTint="@null"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />
    <Button
        android:id="@+id/navAbout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:backgroundTint="@color/surface"
        android:minWidth="0dp"
        android:text="@string/nav_about"
        android:drawableTop="@drawable/ic_nav_about"
        android:drawablePadding="2dp"
        android:textAllCaps="false"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:minHeight="56dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/navigation_item"
        app:backgroundTint="@null"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />
</LinearLayout>
