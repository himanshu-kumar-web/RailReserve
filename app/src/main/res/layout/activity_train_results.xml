<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/resultsRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_soft" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEARCH RESULTS" android:textColor="@color/brand" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.1" />
    <TextView android:id="@+id/resultsHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/resultsSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:layout_marginBottom="14dp" />
    <ProgressBar android:id="@+id/resultsProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="32dp" />
    <TextView android:id="@+id/resultsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/muted" android:visibility="gone" android:padding="24dp" />
    <ListView android:id="@+id/resultsList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="12dp" android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>
